// tgopus.lib: Opus 1.3.1 fixed-point static library + benchmark API.
TARGET        tgopus.lib
TARGETTYPE    lib
OPTION GCCE   -O2 -fomit-frame-pointer
MACRO         HAVE_CONFIG_H
MACRO         OPUS_BUILD
MACRO         FIXED_POINT
MACRO         DISABLE_FLOAT_API
MACRO         VAR_ARRAYS

SYSTEMINCLUDE \epoc32\include
SYSTEMINCLUDE \epoc32\include\libc
USERINCLUDE   ..\config
USERINCLUDE   ..\src\include
USERINCLUDE   ..\src\celt
USERINCLUDE   ..\src\silk
USERINCLUDE   ..\src\silk\fixed
USERINCLUDE   ..\src

